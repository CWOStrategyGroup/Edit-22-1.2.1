{
  "manifest_version": 3,
  "name": "Edit-22",
  "version": "2.0.0",
  "description": "Paste an edited version of your essay and Edit-22 changes only what's different in your Google Doc.",
  "permissions": ["debugger", "sidePanel", "storage", "clipboardRead", "clipboardWrite", "offscreen"],
  "host_permissions": ["https://docs.google.com/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "panel.html" },
  "action": {
    "default_title": "Open Edit-22",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "minimum_chrome_version": "116"
}
